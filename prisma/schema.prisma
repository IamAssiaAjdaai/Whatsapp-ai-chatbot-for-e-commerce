generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  TEXT
  AUDIO
  INTERACTIVE
  SYSTEM
}

enum ConversationState {
  IDLE
  BROWSING
  CART
  CHECKOUT_ADDRESS
  CHECKOUT_DELIVERY
  CHECKOUT_PAYMENT
  CONFIRMATION_PENDING
  ORDER_PLACED
  CANCELLATION
  HUMAN_HANDOFF
}

model User {
  id             String   @id @default(cuid())
  phoneNumber    String   @unique
  preferredLang  String?
  state          ConversationState @default(IDLE)
  lastStateUpdate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       Message[]
  carts          Cart[]
  orders         Order[]
}

model Message {
  id             String   @id @default(cuid())
  userId         String
  timestamp      DateTime @default(now())
  type           MessageType
  language       String?
  rawPayload     Json
  normalizedText String?
  direction      String
  user           User     @relation(fields: [userId], references: [id])
}

model Transcript {
  id          String @id @default(cuid())
  messageId   String @unique
  text        String
  confidence  Float?
  durationSec Float?
  createdAt   DateTime @default(now())
}

model Cart {
  id        String @id @default(cuid())
  userId    String
  status    String @default("OPEN")
  currency  String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id])
}

model Order {
  id             String @id @default(cuid())
  userId         String
  cartId         String
  status         String
  totalAmount    Float
  currency       String
  address        Json
  deliveryOption String
  paymentMethod  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User @relation(fields: [userId], references: [id])
}
